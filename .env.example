# ---- monitoring ----
TARGETS_FILE=target.txt
CHECK_INTERVAL=60s        # cron-like frequency (e.g. 30s, 5m, 1h)
HTTP_TIMEOUT=10s
ALERT_ONLY=false          # true = only print alerts to console
LOG_FILE=/app/data/status.txt
LOG_MAX_KB=512            # cleanup: rotate txt file when bigger than this

# ---- email (all optional) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
MAIL_FROM=you@gmail.com
MAIL_TO=alert-recipient@example.com

# ---- chat webhooks (optional) ----
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/AAAA/messages?key=...&token=...

NOTIFY_RECOVER=true
