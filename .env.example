# ---- monitoring ----
# Path to targets file
TARGETS_FILE=target.txt
# cron-like frequency (e.g. 30s, 5m, 1h, or plain seconds 45)
CHECK_INTERVAL=60s
# per-request / per-probe timeout
HTTP_TIMEOUT=10s
# true = only print alerts to console
ALERT_ONLY=false
# log file path (docker: use the absolute container path)
LOG_FILE=/app/data/status.txt
# rotate txt file when bigger than this (KB)
LOG_MAX_KB=512

# ---- email (all optional) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
MAIL_FROM=you@gmail.com
MAIL_TO=alert-recipient@example.com

# ---- chat webhooks (optional) ----
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/AAAA/messages?key=...&token=...

# also notify when a target comes back up
NOTIFY_RECOVER=true
